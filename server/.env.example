# 本地开发环境变量（复制为 .env.local 后按需修改）

# 前端请求域名（小程序/ H5 都走这里拼 URL）
PROJECT_DOMAIN=http://localhost:3000

# 后端监听端口
PORT=3000

# 静态资源对外地址（生成的图片 URL 前缀）
PUBLIC_BASE_URL=http://localhost:3000

# step2 允许的额外图片主机（逗号或单个 URL，用于域名白名单）
# EXTRA_ALLOWED_HOSTS=https://cdn.example.com

# 上传目录（相对 server 运行目录，或绝对路径）
UPLOAD_DIR=./uploads

# 生图实现：comfy（默认）| mock（透传输入图，只测链路）
IMAGE_GENERATOR=comfy

# ComfyUI
COMFYUI_BASE_URL=http://127.0.0.1:8188
# 请改成你 models/checkpoints 下的真实文件名
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
COMFYUI_CONTROLNET=control_v11p_sd15_canny.pth
COMFYUI_STEPS=16
COMFYUI_CN_STRENGTH=0.72
COMFYUI_CANNY_LOW=0.2
COMFYUI_CANNY_HIGH=0.55
COMFYUI_TIMEOUT_MS=600000
# 可选：自定义 workflow JSON 路径（支持 {{PROMPT}} {{IMAGE}} {{DENOISE}}）
# COMFYUI_WORKFLOW_PATH=./workflows/seal-step1.json
